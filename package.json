    "test:indicators": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs test/indicators.test.ts",
    "test:backtest": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs test/backtest.test.ts",
    "test:bingx": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs test/bingx.test.ts"
